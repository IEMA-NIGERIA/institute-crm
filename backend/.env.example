# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_NAME=iema-crm
PORT=8080
LOG_LEVEL=info

# Comma-separated origins allowed to send credentialed (cookie) requests.
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies / load balancers in front of the API (0 when exposed directly).
TRUST_PROXY_HOPS=0

# Generate with: openssl rand -hex 32   (min 32 chars; rotating it logs everyone out)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=259200
JWT_ISSUER=iema-crm

COOKIE_NAME=iema_session
COOKIE_SECURE=true
# lax when frontend and API share a site (e.g. app.iema.org + api.iema.org); none if on different sites.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.iema.org

BCRYPT_COST=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
DB_POOL_MAX=10
DB_LOG_QUERIES=false
